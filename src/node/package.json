{
  "name": "@counterstrat/demoparser",
  "version": "0.1.0",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./wasm": {
      "types": "./wasm/demoparser.d.ts",
      "node": "./wasm-node.js",
      "default": "./wasm/demoparser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "wasm-node.js",
    "wasm/"
  ],
  "napi": {
    "binaryName": "demoparser",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "x86_64-unknown-linux-musl",
      "universal-apple-darwin"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/counterstrat/demoparser.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "npm run build:wasm && npm run build:native && npm run check:exports && npm run check:wasm && npm run create:npm-dirs",
    "build:debug": "napi build --platform --esm",
    "build:native": "napi build --platform --release --esm",
    "build:wasm": "cd ../wasm && ./build.sh",
    "check:exports": "node check-exports.js",
    "check:wasm": "node check-wasm-exports.js",
    "create:npm-dirs": "napi create-npm-dirs",
    "prepack": "npm run build:wasm && npm run build:native && npm run check:exports && npm run check:wasm",
    "prepublishOnly": "npm run create:npm-dirs && napi prepublish -t npm",
    "test": "node --test \"tests/**/*.test.js\"",
    "pack:testdata": "node scripts/pack-testdata.js",
    "pack:local": "node scripts/pack-local.js",
    "universal": "napi universalize",
    "version": "napi version"
  }
}
